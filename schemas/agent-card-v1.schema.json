{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbootup.dev/schemas/agent-card-v1.schema.json",
  "title": "agentbootup Agent Card",
  "type": "object",
  "required": ["name", "description", "version", "extensions"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "description": "Document version (semver of this card payload)" },
    "url": { "type": "string", "format": "uri" },
    "defaultInputModes": { "type": "array", "items": { "type": "string" } },
    "defaultOutputModes": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "array",
      "description": "A2A-style capability descriptors (optional in v1)",
      "items": { "type": "object", "additionalProperties": true }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Logical skill ids (directory names) when known"
    },
    "extensions": {
      "type": "object",
      "required": ["agentbootup"],
      "properties": {
        "agentbootup": {
          "type": "object",
          "required": ["schema_version", "project_id", "agent_id"],
          "additionalProperties": true,
          "properties": {
            "schema_version": { "type": "string", "pattern": "^1\\." },
            "project_id": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "string", "minLength": 1 },
            "env": { "type": ["string", "null"] },
            "package_name": { "type": "string" },
            "package_version": { "type": "string" },
            "skill_names": {
              "type": "array",
              "items": { "type": "string" }
            },
            "skills_by_cli": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "messages_url_hint": {
              "type": "string",
              "pattern": "^/agents/[^/]+/execute$",
              "description": "Canonical execute route for this agent card, always /agents/<id>/execute."
            }
          }
        }
      }
    }
  }
}
